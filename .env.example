# Copy to .env and adjust. Never commit .env.

# corpus snapshot served by the API and the evidence policy for current-law answers
ACTIVE_SNAPSHOT=corpus-2026-09-30
CURRENCY_POLICY=pilot            # strict = only human-verified provisions; pilot = + official consolidation / listed current

# vector store: leave empty for the embedded local store, set for a Qdrant server
QDRANT_URL=
QDRANT_API_KEY=

# models (read from the local Hugging Face cache when HF_OFFLINE=true)
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MODEL_DEVICE=auto                # auto | cpu | cuda
HF_OFFLINE=true

# retrieval
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
RERANK_TOP_K=5
REFUSAL_THRESHOLD=0.8            # tuned on the dev split, see reports/policy_tuning.json

# answering: extractive runs offline; anthropic uses the Claude agent
LLM_PROVIDER=extractive
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_SERVER_FALLBACK=true
ANTHROPIC_API_KEY=

# logs store a hash of each question unless set to plain
LOG_QUESTIONS=hash
